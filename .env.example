# Copy this file to .env and replace every "change-me" value.
# .env is ignored by Git; never commit real secrets.

# --- General ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (used by the db service and by Prisma) ---
POSTGRES_USER=cmpc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cmpc_libros
# Inside Docker Compose the host is "db". For local development outside Docker use "localhost".
DATABASE_URL=postgresql://cmpc:change-me@db:5432/cmpc_libros

# --- Authentication ---
# In production the secret must have at least 32 characters.
JWT_SECRET=change-me-with-at-least-32-characters
JWT_EXPIRES_IN=1h

# --- HTTP ---
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
# Login rate limit: THROTTLE_LIMIT requests every THROTTLE_TTL seconds.
THROTTLE_TTL=60
THROTTLE_LIMIT=5

# --- Uploads ---
UPLOAD_DIR=/app/uploads

# --- Seed (initial admin user) ---
# Set to false outside local development.
SEED_ON_START=true
ADMIN_EMAIL=admin@cmpc.local
ADMIN_PASSWORD=change-me

# --- Ports published by Docker Compose ---
BACKEND_PORT=3000
FRONTEND_PORT=8080
DB_PORT=5432
