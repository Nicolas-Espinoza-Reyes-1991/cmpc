# Copy this file to .env and replace every "change-me" value.
# .env is ignored by Git; never commit real secrets.
#
# Docker Compose reads this file for the whole stack (`docker compose up --build`).
# Running the backend outside Docker reads it too (backend/.env or the repo-root .env),
# and so do the `npm run prisma:migrate` and `npm run prisma:deploy` scripts of the backend.

# --- General (local development only) ---
# Compose always runs the backend with NODE_ENV=production and its own PORT (3000).
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
# Compose builds the backend's DATABASE_URL from these three values, so a
# password with special characters (@ : / ? #) must be URL-encoded.
POSTGRES_USER=cmpc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cmpc_libros
# Only for the backend running OUTSIDE Docker (e.g. `docker compose up -d db`
# and `npm run start:dev`): it reaches the published DB_PORT on localhost.
# Compose ignores this variable.
DATABASE_URL=postgresql://cmpc:change-me@localhost:5442/cmpc_libros

# --- Authentication ---
# In production the secret must have at least 32 characters.
JWT_SECRET=change-me-with-at-least-32-characters
JWT_EXPIRES_IN=1h

# --- HTTP ---
# Comma-separated list of allowed origins. Not needed behind nginx (same origin);
# it only matters for the Vite dev server calling the API directly.
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
# Login rate limit: THROTTLE_LIMIT requests every THROTTLE_TTL seconds.
THROTTLE_TTL=60
THROTTLE_LIMIT=5

# --- Uploads (backend outside Docker; the container uses /app/uploads) ---
UPLOAD_DIR=./uploads

# --- Seed (initial admin user) ---
# Creates the user only if it does not exist and never overwrites it.
# Set to false outside local development.
SEED_ON_START=true
ADMIN_EMAIL=admin@cmpc.local
ADMIN_PASSWORD=change-me

# --- Ports published on the host by Docker Compose ---
# The frontend is the only service meant to be reached by users. The others are
# published on 127.0.0.1 only. The containers always use their standard ports
# (backend 3000, PostgreSQL 5432); these are just the host side.
FRONTEND_PORT=8080
BACKEND_PORT=3000
# Not 5432 on purpose: a local PostgreSQL usually owns that port.
DB_PORT=5442

# --- pgAdmin (optional: `docker compose --profile tools up`) ---
# pgAdmin rejects reserved domains such as ".local" in the email.
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
